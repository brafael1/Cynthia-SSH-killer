#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat <<EOF
Uso: $(basename "$0") <local|remote> [OPÇÕES]

Entry point único do Cynthia-SSH-killer.

MODO LOCAL — encerra as sessões SSH deste host (exige sudo):
  $(basename "$0") local --ip IP_PERMITIDO

MODO REMOTO — envia e executa o killer em um host remoto:
  $(basename "$0") remote -H HOST -u USUARIO -e IP_EXTERNO [-k CHAVE] [-p SENHA] [-d DIR]

OPÇÕES GERAIS:
  -h, --help        Mostra esta ajuda

AUTENTICAÇÃO REMOTA:
  - Chave: -k. Com senha na chave, use ssh-agent.
    Sem -p, o sudo remoto precisa estar configurado como NOPASSWD.
  - Senha: -p (usada no SSH e no sudo).
  - Ambos: -k autentica o SSH; -p é o fallback do SSH e a senha do sudo.

EXEMPLOS:
  $(basename "$0") local --ip 192.168.2.254
  $(basename "$0") remote -H 192.168.2.18 -u spying -k ~/.ssh/id_ed25519 -e 192.168.2.254
  $(basename "$0") remote -H 192.168.2.18 -u spying -p 'senha' -e 192.168.2.254
EOF
    exit "${1:-0}"
}

MODULO="${1:-}"
if [[ -z "$MODULO" ]]; then
    usage
fi

case "$MODULO" in
    -h|--help|help) usage ;;

    local)
        shift
        for arg in "$@"; do
            if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
                bash "$ROOT/bin/encerrar-sessoes-ssh.sh" "$@"
                exit $?
            fi
        done
        exec sudo bash "$ROOT/bin/encerrar-sessoes-ssh.sh" "$@"
        ;;

    remote)
        shift
        source "$ROOT/lib/loader.sh"
        lib_carregar remoto.sh
        cli_remote "$@"
        ;;

    *) echo "Erro: modo desconhecido: $MODULO" >&2; usage 1 ;;
esac